# Not committed, though in production root.crt may be: each test bed makes
# its own CA. root.key never leaves the offline machine.
/*/ca/

# Not committed: encrypted, but not public either.
/*/state/

# Not committed, though in production pubkeys/ is: each test bed makes its
# own keys.
/*/pubkeys/
/keyring/

# Not committed: the development seal's key.
/workload-vault/seal-key/

